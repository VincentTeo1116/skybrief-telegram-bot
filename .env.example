# Copy this file to ".env" for local runs. NEVER commit ".env" to GitHub.
# On a hosting platform (Railway, VPS...) set these as environment variables instead.

# Required. From @BotFather (/newbot).
TELEGRAM_BOT_TOKEN=

# Strongly recommended. Comma-separated Telegram user IDs allowed to use the bot
# (get yours by messaging @userinfobot). Leave empty and ANYONE can use your bot.
ALLOWED_USER_IDS=

# Optional. Free token from https://aqicn.org/data-platform/token/
# Gives real measured AQI from the nearest monitoring station (more accurate than the model).
WAQI_TOKEN=

# Where the saved locations live. On a host with a persistent volume use e.g. /data/bot.db
DB_PATH=data/bot.db

# Default daily report time for new users (24h, in the local time of their location).
DEFAULT_DAILY_TIME=08:30

LOG_LEVEL=INFO
