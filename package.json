{
  "name": "skybrief",
  "version": "2.0.0",
  "private": true,
  "description": "SkyBrief: Telegram weather & air-quality bot on Cloudflare Workers",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "node scripts/integration.mjs",
    "db:migrate:local": "wrangler d1 migrations apply skybrief --local",
    "db:migrate:remote": "wrangler d1 migrations apply skybrief --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261103.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.156.2"
  }
}
