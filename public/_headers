# Security headers for every static file of the mini app (NFR-6).
#
# script-src   our own files + Telegram's official Mini App script. No inline scripts, no eval.
# style-src    our own stylesheet only. No inline styles (the page sets dynamic values through the CSSOM).
# font-src     the app's own font files in /fonts/ only.
# connect-src  the page only ever talks to this Worker's /api/.
# frame-ancestors  Telegram's web client shows mini apps in a frame; nobody else may frame the page.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self' https://telegram.org; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors https://web.telegram.org; base-uri 'none'; form-action 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  X-Robots-Tag: noindex
